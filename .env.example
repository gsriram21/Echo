# Copy this file to .env.local and put your real key in it.
#
#   cp .env.example .env.local
#
# .env.local is gitignored and must never be committed.
# The key is only ever read by the serverless function in api/, never by the browser.
#
# Get a key at console.anthropic.com. The API is prepaid — add credit under Billing,
# or calls will fail with an authentication-looking error that is really a billing error.

ANTHROPIC_API_KEY=sk-ant-your-key-here
